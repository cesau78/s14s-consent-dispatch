# Local Docker Compose dev stack (see docker-compose.dev.yml and README).
PORT=3000
TRUST_PROXY=false

KETCH_WEBHOOK_PATHS=/ketch/webhook,/ketch/forwarder
KETCH_WEBHOOK_AUTH_HEADER=Authorization
# Required for host → container curls (caller IP is not loopback inside Docker).
KETCH_WEBHOOK_AUTH_VALUE=Bearer local-dev

KETCH_VIBES_PERSON_KEY_IDENTITY_SPACES=vibes_person_key,person_key
KETCH_EXTERNAL_PERSON_ID_IDENTITY_SPACES=account_id,external_person_id,customer_id
KETCH_PHONE_IDENTITY_SPACES=phone,mobile,mdn,mobile_phone
KETCH_PHONE_CONTEXT_KEYS=phone,mobilePhone,mobile_phone,mdn

# WireMock service in docker-compose.dev.yml (overridden to http://wiremock:8080 in compose).
VIBES_API_BASE_URL=http://localhost:8080
VIBES_COMPANY_KEY=local-dev
VIBES_API_USERNAME=wiremock-user
VIBES_API_PASSWORD=wiremock-pass
VIBES_API_VERSION=2
