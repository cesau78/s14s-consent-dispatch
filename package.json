{
  "name": "s14s-consent-dispatch",
  "version": "0.1.0",
  "description": "Dispatches marketing consent and identity updates from Ketch to downstream engagement platforms",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "test": "jest --coverage --forceExit --detectOpenHandles",
    "test:watch": "jest --watch",
    "build": "npm test",
    "dev:compose": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up --build",
    "smoke:local": "node scripts/smoke-local.js",
    "smoke:local:docker": "node scripts/smoke-local.js",
    "prepare": "husky"
  },
  "license": "ISC",
  "dependencies": {
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "libphonenumber-js": "^1.12.38"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "supertest": "^7.2.2"
  }
}
