# =============================================================================
# S14S Consent Dispatch — environment template
# =============================================================================
# Copy to .env and set values for your deployment:
#   cp .env.example .env
#
# Other files:
#   .env.dev     — committed defaults for Docker + WireMock (see README)
#   .env         — your local/production secrets (gitignored)
# =============================================================================

# --- Server ------------------------------------------------------------------
PORT=3000
# Trust X-Forwarded-For behind a load balancer: true | false | hop count (e.g. 1)
TRUST_PROXY=false

# =============================================================================
# Ketch  (every variable name starts with KETCH_)
# =============================================================================

# Inbound Forwarder (CorrectionRequest, ConsentRequest, …)
KETCH_CALLBACK_PATHS=/ketch/webhook,/ketch/forwarder
KETCH_CALLBACK_AUTH_HEADER=Authorization
# Production: unique secret, same value registered in Ketch Forwarder
# Local dev:  Bearer local-dev (also requires loopback / Docker bridge peer)
KETCH_CALLBACK_AUTH_VALUE=
# Legacy aliases: KETCH_WEBHOOK_PATHS, KETCH_WEBHOOK_AUTH_HEADER, KETCH_WEBHOOK_AUTH_VALUE, KETCH_FORWARDER_AUTH
# Required — Ketch Forwarder egress IPs/CIDR (empty = deny all inbound Ketch callbacks)
KETCH_ALLOWED_IPS=

# Outbound Web API (Vibes MO opt-out → POST /consent/{org}/update)
KETCH_API_BASE_URL=https://global.ketchcdn.com/web/v2
# KETCH_API_KEY=
KETCH_ORGANIZATION_CODE=
KETCH_PROPERTY_CODE=
KETCH_ENVIRONMENT_CODE=production
KETCH_JURISDICTION_CODE=

# ConsentRequest → downstream opt-out
KETCH_SMS_MARKETING_PURPOSE_CODES=sms_mktg
KETCH_EMAIL_MARKETING_PURPOSE_CODES=email_mktg
KETCH_CONSENT_ORIGIN_CONTEXT_KEY=consent_dispatch_origin
KETCH_CONSENT_ORIGIN_VIBES_SMS=vibes_sms_optout
KETCH_CONSENT_ORIGIN_MESSAGEGEARS_EMAIL=messagegears_email_optout

# Forwarder payload fields routed to Vibes
KETCH_VIBES_PERSON_KEY_IDENTITY_SPACES=vibes_person_key,person_key
KETCH_EXTERNAL_PERSON_ID_IDENTITY_SPACES=account_id,external_person_id,customer_id
KETCH_PHONE_IDENTITY_SPACES=phone,mobile,mdn,mobile_phone
KETCH_PHONE_CONTEXT_KEYS=phone,mobilePhone,mobile_phone,mdn

# Forwarder payload fields routed to MessageGears
KETCH_EMAIL_IDENTITY_SPACES=email,email_address
KETCH_EMAIL_CONTEXT_KEYS=email,emailAddress,email_address
KETCH_MESSAGEGEARS_RECIPIENT_ID_IDENTITY_SPACES=messagegears_recipient_id,recipient_id
KETCH_MESSAGEGEARS_EXTERNAL_RECIPIENT_ID_IDENTITY_SPACES=account_id,external_person_id,customer_id,external_recipient_id

# =============================================================================
# Vibes  (every variable name starts with VIBES_)
# =============================================================================

VIBES_CALLBACK_PATH=/vibes/webhook
VIBES_CALLBACK_AUTH_HEADER=Authorization
VIBES_CALLBACK_AUTH_VALUE=
# Required — Vibes MO callback egress IPs/CIDR (empty = deny all inbound Vibes callbacks)
VIBES_ALLOWED_IPS=
VIBES_SMS_OPT_OUT_KEYWORDS=no

VIBES_API_BASE_URL=https://public-api.vibescm.com
VIBES_COMPANY_KEY=
VIBES_API_USERNAME=
VIBES_API_PASSWORD=
VIBES_API_VERSION=2
VIBES_SMS_SUBSCRIPTION_LIST_ID=

# =============================================================================
# MessageGears  (every variable name starts with MESSAGEGEARS_)
# =============================================================================

MESSAGEGEARS_API_BASE_URL=https://api.messagegears.com
MESSAGEGEARS_ACCOUNT_ID=
MESSAGEGEARS_API_KEY=
# MESSAGEGEARS_OPT_OUT_PAYLOAD_JSON={"emailOptIn":false}
